# Скопіюйте цей файл у .env і заповніть значення.
# Файл .env у репозиторій не потрапляє - він у .gitignore.

# База даних. За замовчуванням - локальний файл SQLite, нічого налаштовувати не треба.
DATABASE_URL=sqlite:///data/concertrip.db

# Ключ до API Ticketmaster Discovery (CT-21).
# Безкоштовний, видається після реєстрації на developer.ticketmaster.com
TICKETMASTER_API_KEY=

# Токен Telegram-бота (CT-54). Видає @BotFather у Telegram.
TELEGRAM_BOT_TOKEN=

# Ключ для витягу дат продажів з тексту анонсу (CT-51).
ANTHROPIC_API_KEY=

# Країни, по яких збираємо події. Коди ISO через кому.
COUNTRIES=GB,NL,DE,FR,PL

# Резервний набір подій для демонстрації без доступу до зовнішніх сервісів.
SEED_CSV=data/seed_events.csv

LOG_LEVEL=INFO

# Auth. Замініть JWT_SECRET перед будь-яким production запуском.
JWT_SECRET=dev-only-change-this-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_EXPIRE_HOURS=24
AUTH_DEV_MODE=true

# Дозволені origins для локальної документації/web-клієнта.
CORS_ORIGINS=http://localhost:3000

# Spotify Web API. Client Secret і encryption key залишаються тільки на backend.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/spotify/callback
SPOTIFY_MOBILE_REDIRECT_URI=concertrip://spotify/callback
SPOTIFY_TOKEN_ENCRYPTION_KEY=
