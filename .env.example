# Скопіюйте цей файл у .env і заповніть значення.
# Файл .env у репозиторій не потрапляє - він у .gitignore.

# База даних. За замовчуванням - локальний файл SQLite, нічого налаштовувати не треба.
DATABASE_URL=sqlite:///data/concertrip.db

# Ключ до API Ticketmaster Discovery (CT-21).
# Безкоштовний, видається після реєстрації на developer.ticketmaster.com
TICKETMASTER_API_KEY=

# Токен Telegram-бота (CT-54). Видає @BotFather у Telegram.
TELEGRAM_BOT_TOKEN=

# Ключ для витягу дат продажів з тексту анонсу (CT-51).
ANTHROPIC_API_KEY=

# Країни, по яких збираємо події. Коди ISO через кому.
COUNTRIES=GB,NL,DE,FR,PL

# Резервний набір подій для демонстрації без доступу до зовнішніх сервісів.
SEED_CSV=data/seed_events.csv

LOG_LEVEL=INFO
